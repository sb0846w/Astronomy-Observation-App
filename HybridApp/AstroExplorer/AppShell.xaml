<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:AstroExplorer.Views"
       x:Class="AstroExplorer.AppShell"
       Shell.BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource CardDark}}"
       Shell.ForegroundColor="{AppThemeBinding Light=White, Dark={StaticResource TextDark}}"
       Shell.TitleColor="{AppThemeBinding Light=White, Dark={StaticResource TextDark}}"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
       Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource AccentDark}}"
       Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource AccentDark}}"
       Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}">

    <!-- Three tabs. Pages come from dependency injection (registered in MauiProgram). -->
    <TabBar>
        <ShellContent Title="Observations" Icon="tab_list.png" Route="observations"
                      ContentTemplate="{DataTemplate views:ObservationsPage}" />
        <ShellContent Title="Explore" Icon="tab_explore.png" Route="explore"
                      ContentTemplate="{DataTemplate views:CataloguePage}" />
        <ShellContent Title="Settings" Icon="tab_settings.png" Route="settings"
                      ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>
</Shell>
