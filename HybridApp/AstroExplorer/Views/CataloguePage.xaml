<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AstroExplorer.Models"
             x:Class="AstroExplorer.Views.CataloguePage"
             Title="Explore the night sky">

    <Grid RowDefinitions="Auto,Auto,*">
        <SearchBar x:Name="SearchBox" Grid.Row="0"
                   Placeholder="Search by name, type or constellation"
                   TextChanged="OnSearchTextChanged" />

        <HorizontalStackLayout Grid.Row="1" Margin="16,0,16,4" Spacing="8">
            <Switch x:Name="FavouritesSwitch" Toggled="OnFavouritesToggled" VerticalOptions="Center" />
            <Label Text="Show favourites only" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <CollectionView x:Name="ObjectList" Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="OnObjectSelected">
            <CollectionView.EmptyView>
                <Label Text="No objects match your search." Style="{StaticResource Subtle}"
                       HorizontalTextAlignment="Center" Margin="32" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CelestialObjectInfo">
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                            <Label Text="{Binding Symbol}" FontSize="30" VerticalOptions="Center" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Name}" Style="{StaticResource Title}" />
                                <Label Style="{StaticResource Accent}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Type}" />
                                            <Span Text="  •  " />
                                            <Span Text="{Binding Constellation}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding CountLabel}" Style="{StaticResource Subtle}" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding FavouriteGlyph}" FontSize="20" TextColor="#E57373" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
